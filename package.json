{
  "name": "ministr",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || ^24.0.0",
    "npm": ">=10 <13"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:links": "bash scripts/check-private-links.sh",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"scripts/**/*.{ts,mjs}\" \"tests/**/*.ts\" \"*.{mjs,ts,json}\" \".github/**/*.yml\"",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "test:fast": "vitest run --exclude 'src/ai/cpuSimulation*.test.ts'",
    "test:cpu": "vitest run src/ai/cpuSimulation*.test.ts",
    "supply:compare": "vite-node scripts/finite-supply-report.ts",
    "balance:compare": "vite-node scripts/balance-compare.ts",
    "balance": "vite-node scripts/balance-report.ts",
    "campaign:playthrough": "vite-node scripts/campaign-playthrough.ts",
    "test:ci": "node --test scripts/ci-policy.check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-node": "^6.0.0",
    "vitest": "5.0.5"
  }
}
