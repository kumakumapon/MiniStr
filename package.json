{
  "name": "ministr",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.0.0 || ^24.0.0",
    "npm": ">=10 <13"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:links": "bash scripts/check-private-links.sh",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"*.{mjs,ts,json}\" \".github/**/*.yml\"",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "test:fast": "vitest run --exclude 'src/ai/cpuSimulation*.test.ts'",
    "test:cpu": "vitest run src/ai/cpuSimulation*.test.ts",
    "balance:compare": "vite-node scripts/balance-compare.ts",
    "balance": "vite-node scripts/balance-report.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.1.0",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.4"
  }
}
